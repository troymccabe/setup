#!/usr/bin/env bash
# Ephemeral Tart-backed GitHub Actions runner — one-shot setup.
#
# Run straight from the repo:
#
#     GH_ORG=YourOrg GH_PAT=ghp_xxxxx mac/runner/setup
#
# Or `curl | sh` from the raw file:
#
#     GH_ORG=YourOrg GH_PAT=ghp_xxxxx \
#         bash <(curl -fsSL https://raw.githubusercontent.com/troymccabe/setup/main/mac/runner/setup)
#
# Or, if you prefer to inspect first:
#
#     curl -fsSL https://raw.githubusercontent.com/troymccabe/setup/main/mac/runner/setup -o setup
#     GH_ORG=... GH_PAT=... bash setup
#
# REQUIRED env vars:
#   GH_ORG          GitHub organization (e.g. "MyOrg")
#   GH_PAT          PAT with "Self-hosted runners (Admin)" permission on the org
#                   Fine-grained tokens are recommended.
#                   With OP_ITEM_REF set this is an INSTALL-TIME-ONLY value: it
#                   creates/scopes the runner group and is then discarded, never
#                   written to disk. Without it, the PAT is persisted in
#                   config.env for the orchestrator to reuse (see "Credentials").
#
# OPTIONAL env vars (defaults shown):
#   RUNNER_GROUP    Org-level runner group name           [macos-runners]
#   SHARED_LABEL    Fleet label all runners carry         [macos-runner]
#   HOST_LABEL      Per-host label (this machine)         [<hostname -s, lowercased>]
#   EXTRA_LABELS    Comma-separated extra labels appended [""]
#                   to every runner registration (e.g.
#                   "mobile-runner" when the image carries
#                   a mobile toolchain). Do NOT put
#                   macos-major-*/xcode-*/image-* here —
#                   those are PROBED from the booted VM and
#                   a static one would be dropped anyway.
#   REQUIRE_XCODE   "1" = a VM with no Xcode is a broken    [0]
#                   image: recycle it instead of
#                   registering a runner without an
#                   xcode-* label. Leave 0 for fleets that
#                   legitimately run Xcode-less images.
#   SCOPE_REPO      "owner/repo" to gate the group to;    [""]
#                   empty = org-wide (any repo in org may use these runners)
#   SOURCE_IMAGE    Remote Tart image, fetched ONCE at    [ghcr.io/cirruslabs/macos-tahoe-xcode:26.5]
#                   install time and materialised as a
#                   local VM. Must be pinned to a version
#                   tag — ":latest" is refused (a moving
#                   tag rolls the fleet silently and
#                   defeats the pin-as-audit-trail).
#   BASE_IMAGE      Name of an EXISTING local Tart VM to  [derived: base-<image>-<tag>]
#                   run from instead of pulling
#                   SOURCE_IMAGE — for images that arrive
#                   out of band (rsync'd from another
#                   host, built with Packer). See "Base
#                   image model" below.
#   REGISTRY_USER   Credentials for `tart login` when     [""]
#   REGISTRY_PAT    SOURCE_IMAGE lives in a private
#                   registry (e.g. a GHCR PAT with
#                   read:packages). Both set → login runs
#                   before the pull; otherwise skipped.
#   RUNNER_VERSION  actions/runner version every VM runs  [2.337.0]
#                   AUTHORITATIVE, not a fallback: a
#                   runner baked into the image is
#                   REPLACED when it disagrees. Bump when
#                   GitHub deprecates the pinned release
#                   — a deprecated runner registers fine
#                   and is then refused at the broker, so
#                   it shows up as a runner that goes
#                   offline seconds after appearing.
#   OP_ITEM_REF     1Password secret reference for the    [""]
#                   registration PAT, e.g.
#                   op://vault/runner-jit-pat/credential
#                   Set it to opt into the op-read model
#                   (see "Credentials" below). Unset =
#                   today's behaviour, unchanged.
#   OP_TOKEN_FILE   Where the 1Password service-account   [~/.config/gha-runner/op-token]
#                   token is stored (0600). Only used
#                   when OP_ITEM_REF is set.
#   VM_MEMORY_MB    Per-VM memory                         [10240]
#   VM_CPU_COUNT    Per-VM CPUs                           [4]
#   VM_DISK_GB      Per-VM disk (GB); empty = keep the    [""]
#                   image's disk. Applied only when it
#                   would GROW the disk — Tart cannot
#                   shrink one, and asking errors.
#   HOST_RESERVE_MB Memory to keep free for the host OS   [6144]
#                   When multiple orchestrators run on
#                   one host, each waits until host has
#                   (VM_MEMORY_MB + HOST_RESERVE_MB) free
#                   before booting. Auto-scales to host
#                   capacity: 16 GB host serialises,
#                   64 GB host fits 5+ concurrent VMs.
#   VM_PREFIX       Name prefix for this install's         [ephem-]
#                   ephemeral VMs. The orchestrator REAPS
#                   every VM carrying its prefix at
#                   startup, so two installs sharing one
#                   host MUST use different prefixes or
#                   each will destroy the other's running
#                   job. Give every extra install on a
#                   host its own (e.g. ephem-s1-,
#                   ephem-s2-) alongside its own
#                   LAUNCHD_LABEL and CONFIG_DIR.
#   LAUNCHD_LABEL   launchd job label                     [dev.<lowercased-GH_ORG>.gha-runner]
#   CONFIG_DIR      Where to stash config + scripts       [~/.gha-runner]
#
# Credentials — two models, chosen per host at install time:
#
#   DEFAULT (OP_ITEM_REF unset). GH_PAT is written to config.env (0600) and the
#   orchestrator sources it. Simple, no extra dependency. The PAT sits on disk
#   indefinitely, so rotating it means editing config.env on every host.
#
#   OP-READ (OP_ITEM_REF set). The PAT is NEVER persisted. The orchestrator
#   fetches it from 1Password at the top of every cycle using a service-account
#   token — the only secret at rest. Rotating the PAT is a vault edit that takes
#   effect on the next cycle, with zero host visits.
#
# What op-read does and does not buy you, stated plainly: it protects the PAT
# from every leak channel that is not host access — logs, screenshots, backups,
# a stray file read. It does NOT protect against host compromise, because an
# attacker holding the service-account token can op-read the PAT themselves.
# Pair it with "a compromised host is rebuilt, not re-credentialed" — cheap
# here, since this script reprovisions a host from scratch and every job already
# runs in a throwaway VM.
#
# There is deliberately NO runtime fallback. If op-read is on and 1Password is
# unreachable, the agent backs off and retries; it does not fall back to a
# persisted PAT, because a fallback PAT on disk would defeat the entire point.
# In-flight jobs are unaffected (the PAT is fetched before a VM is cloned); new
# cycles stall until 1Password returns. GH_PAT survives as an env override for
# local debugging only — never put it in the plist.
#
# Base image model:
#   The remote image is materialised ONCE as a local Tart VM
#   (~/.tart/vms/<BASE_IMAGE>) and config.env records the LOCAL name — the
#   per-job `tart clone` never consults a registry. When the per-job path
#   cloned a remote ref instead, the image lived in Tart's OCI cache, which
#   auto-prunes under disk pressure; on a 256 GB host that degenerated into
#   re-downloading the full image on EVERY cycle (observed: 64 GB × 398
#   pulls ≈ 27 TB, ~55 min/cycle, runner offline ~95% of the time). Local
#   VMs are never auto-pruned, and per-job clones are APFS copy-on-write —
#   cycles cost seconds and ~zero extra disk.
#
# Re-running is idempotent — the runner group + repo scoping are no-op on
# the second pass, the orchestrator + plist are overwritten with the same
# content, the launchd service is cycled.
#
# Surviving reboots:
#   This installs a LaunchAgent, which loads only inside a logged-in GUI
#   (Aqua) session — NOT at the login window. A LaunchDaemon won't help:
#   Tart uses Virtualization.framework, which needs a GUI session, so it
#   can't run pre-login. For an unattended runner, configure the host to
#   log in automatically on boot:
#     • System Settings ▸ Users & Groups ▸ "Automatically log in as" ▸ <user>
#       (requires FileVault OFF — it blocks auto-login).
#     • sudo pmset -a sleep 0 displaysleep 0   # don't let the host sleep
#     • System Settings ▸ Energy ▸ "Start up automatically after a power
#       failure" (or: sudo pmset -a autorestart 1).
#   With auto-login on: reboot → login → LaunchAgent loads → orchestrator
#   starts. Without it, someone must log in once after each reboot.
#
# Scaling beyond one host:
#   This is a single-host design — each Mac runs its own launchd loop and
#   schedules VMs against its LOCAL free RAM (see HOST_RESERVE_MB). That's
#   simplest for 1–2 machines. At ~3+ hosts, consider Orchard
#   (https://github.com/cirruslabs/orchard), Cirrus's cluster scheduler
#   for Tart: a central controller bin-packs VMs across a pool of workers,
#   replacing the per-host capacity guessing (wait_for_ram_capacity),
#   manual HOST_RESERVE_MB tuning, and orphan reaping with fleet-wide
#   scheduling and one `orchard list vms` view. Caveats: it still drives
#   `tart` (so the GUI-login requirement above is unchanged), it adds a
#   controller to run, and the GHA JIT-registration glue below stays yours
#   — Orchard places VMs, it doesn't register runners.
#
# Requires: macOS 14+, Apple Silicon, Homebrew.

set -euo pipefail

__main__() {
  # -----------------------------------------------------------------------
  # Required inputs
  # -----------------------------------------------------------------------
  : "${GH_ORG:?GH_ORG must be set (e.g. GH_ORG=MyOrg)}"
  : "${GH_PAT:?GH_PAT must be set (PAT with Self-hosted runners: Admin)}"

  # -----------------------------------------------------------------------
  # Optional inputs with defaults
  # -----------------------------------------------------------------------
  local ORG_LOWER
  ORG_LOWER="$(printf '%s' "$GH_ORG" | tr '[:upper:]' '[:lower:]')"

  RUNNER_GROUP="${RUNNER_GROUP:-macos-runners}"
  SHARED_LABEL="${SHARED_LABEL:-macos-runner}"
  HOST_LABEL="${HOST_LABEL:-$(hostname -s | tr '[:upper:]' '[:lower:]')}"
  EXTRA_LABELS="${EXTRA_LABELS:-}"
  REQUIRE_XCODE="${REQUIRE_XCODE:-0}"
  SCOPE_REPO="${SCOPE_REPO:-}"
  REGISTRY_USER="${REGISTRY_USER:-}"
  REGISTRY_PAT="${REGISTRY_PAT:-}"
  RUNNER_VERSION="${RUNNER_VERSION:-2.337.0}"
  OP_ITEM_REF="${OP_ITEM_REF:-}"
  OP_TOKEN_FILE="${OP_TOKEN_FILE:-$HOME/.config/gha-runner/op-token}"

  if [[ -n "$OP_ITEM_REF" && "$OP_ITEM_REF" != op://* ]]; then
    echo "ERROR: OP_ITEM_REF must be a 1Password secret reference (got: $OP_ITEM_REF)" >&2
    echo "       e.g. op://vault-name/runner-jit-pat/credential" >&2
    exit 1
  fi
  SOURCE_IMAGE="${SOURCE_IMAGE:-ghcr.io/cirruslabs/macos-tahoe-xcode:26.5}"
  BASE_IMAGE="${BASE_IMAGE:-}"
  VM_MEMORY_MB="${VM_MEMORY_MB:-10240}"
  VM_CPU_COUNT="${VM_CPU_COUNT:-4}"
  VM_DISK_GB="${VM_DISK_GB:-}"
  HOST_RESERVE_MB="${HOST_RESERVE_MB:-6144}"
  VM_PREFIX="${VM_PREFIX:-ephem-}"
  # The prefix is spliced into VM names and matched with startswith() when
  # reaping, so anything outside this set either cannot name a VM or would
  # widen the reap beyond this install.
  if [[ ! "$VM_PREFIX" =~ ^[a-z0-9][a-z0-9-]*-$ ]]; then
    echo "ERROR: VM_PREFIX must be lowercase alphanumeric/dashes ending in '-' (got: $VM_PREFIX)" >&2
    exit 1
  fi
  LAUNCHD_LABEL="${LAUNCHD_LABEL:-dev.$ORG_LOWER.gha-runner}"
  CONFIG_DIR="${CONFIG_DIR:-$HOME/.gha-runner}"

  local CONFIG_FILE="$CONFIG_DIR/config.env"
  local ORCH_SCRIPT="$CONFIG_DIR/orchestrator.sh"
  local PLIST_PATH="$HOME/Library/LaunchAgents/$LAUNCHD_LABEL.plist"

  # Two installs on one host must not have OVERLAPPING prefixes. Reaping
  # matches with startswith(), so the default "ephem-" also matches
  # "ephem-s1-..." — a default install beside slot installs silently destroys
  # their running VMs at every startup, which presents as CI jobs dying for no
  # reason rather than as a misconfiguration. Equal prefixes are the same bug.
  #
  # Every install records its CONFIG_DIR in its own plist, so the other
  # installs on this host are discoverable; read each one's prefix and refuse
  # before writing anything.
  local _other_plist _other_cfg _other_prefix
  for _other_plist in "$HOME/Library/LaunchAgents/"*.plist; do
    [[ -r "$_other_plist" ]] || continue
    [[ "$_other_plist" == "$PLIST_PATH" ]] && continue
    grep -q '<key>CONFIG_DIR</key>' "$_other_plist" 2>/dev/null || continue
    _other_cfg="$(sed -n '/<key>CONFIG_DIR<\/key>/{n;s/.*<string>\(.*\)<\/string>.*/\1/p;}' "$_other_plist")"
    [[ -n "$_other_cfg" && -r "$_other_cfg/config.env" ]] || continue
    _other_prefix="$(sed -n 's/^VM_PREFIX="\(.*\)"$/\1/p' "$_other_cfg/config.env")"
    # Installs predating VM_PREFIX used the default.
    _other_prefix="${_other_prefix:-ephem-}"
    if [[ "$VM_PREFIX" == "$_other_prefix"* || "$_other_prefix" == "$VM_PREFIX"* ]]; then
      echo "ERROR: VM_PREFIX '$VM_PREFIX' overlaps '$_other_prefix', already used by" >&2
      echo "       the install at $_other_cfg ($(basename "$_other_plist" .plist))." >&2
      echo "       Each install reaps every VM carrying its prefix at startup, so" >&2
      echo "       overlapping prefixes destroy each other's running jobs." >&2
      echo "       Give this install a non-overlapping prefix, e.g. VM_PREFIX=ephem-s2-" >&2
      exit 1
    fi
  done

  step() { printf '\n==> %s\n' "$*"; }
  gh_api() {
    curl -fsS \
      -H "Authorization: Bearer $GH_PAT" \
      -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      "$@"
  }

  # -----------------------------------------------------------------------
  # Sanity checks
  # -----------------------------------------------------------------------
  step "Sanity checks"
  if [[ "$(uname -m)" != "arm64" ]]; then
    echo "ERROR: Apple Silicon required" >&2; exit 1
  fi
  if ! command -v brew >/dev/null; then
    echo "ERROR: Homebrew required (https://brew.sh)" >&2; exit 1
  fi
  echo "  macOS $(sw_vers -productVersion) on $(uname -m), org=$GH_ORG ✓"

  # -----------------------------------------------------------------------
  # Tooling
  # -----------------------------------------------------------------------
  step "Installing tart + softnet + jq + sshpass"
  # softnet is a sibling formula in the cirruslabs/cli tap and is
  # pulled in as a transitive dependency of tart. Homebrew 4.4+ gates
  # per-formula trust in third-party taps — naming both formulae
  # explicitly on the install command line makes brew treat each as
  # user-requested (and therefore trusted), so the install proceeds.
  if ! brew install \
      cirruslabs/cli/softnet \
      cirruslabs/cli/tart \
      jq sshpass 2>&1 | grep -E "^(==>|Warning|Error)"; then
    echo "  (no warnings)"
  fi
  if ! command -v tart >/dev/null; then
    echo "ERROR: tart didn't install — see brew output above" >&2
    exit 1
  fi

  # -----------------------------------------------------------------------
  # 1Password CLI + service-account token (op-read model only)
  # -----------------------------------------------------------------------
  if [[ -n "$OP_ITEM_REF" ]]; then
    step "Installing 1password-cli (OP_ITEM_REF is set)"
    if ! command -v op >/dev/null; then
      brew install --quiet 1password-cli 2>&1 | grep -E "^(==>|Warning|Error)" || true
    fi
    command -v op >/dev/null || { echo "ERROR: 1password-cli didn't install" >&2; exit 1; }

    if [[ ! -s "$OP_TOKEN_FILE" ]]; then
      step "1Password service-account token"
      echo "  Paste the service-account token (read-only on the vault holding"
      echo "  $OP_ITEM_REF). Input is hidden; it is written 0600 and is the only"
      echo "  secret that will live on this host."
      local _op_token
      read -r -s -p "  token: " _op_token < /dev/tty; echo
      [[ -n "$_op_token" ]] || { echo "ERROR: empty token" >&2; exit 1; }
      mkdir -p "$(dirname "$OP_TOKEN_FILE")"
      ( umask 077; printf '%s\n' "$_op_token" > "$OP_TOKEN_FILE" )
      unset _op_token
    else
      echo "  token file already present at $OP_TOKEN_FILE — leaving it alone"
    fi
    chmod 600 "$OP_TOKEN_FILE"

    # Fail here, not silently at 3am on the first job cycle.
    step "Verifying op can read $OP_ITEM_REF"
    if ! OP_SERVICE_ACCOUNT_TOKEN="$(cat "$OP_TOKEN_FILE")" \
         op read "$OP_ITEM_REF" >/dev/null 2>&1; then
      echo "ERROR: op could not read $OP_ITEM_REF with the stored token." >&2
      echo "       Check the reference, the token, and that the service account" >&2
      echo "       has read access to that vault. Token left at $OP_TOKEN_FILE;" >&2
      echo "       delete it to be re-prompted." >&2
      exit 1
    fi
    echo "  op read OK — the PAT will be fetched per cycle and never persisted"
  fi

  # -----------------------------------------------------------------------
  # Base image → a LOCAL Tart VM (config.env never records a remote ref)
  # -----------------------------------------------------------------------
  # The orchestrator clones from a LOCAL VM name. A remote ref would make
  # every cycle consult the registry, and remote images live in Tart's OCI
  # cache, which auto-prunes under disk pressure — on a small SSD that turns
  # into re-downloading the full image on EVERY cycle (see "Base image
  # model" in the header). Local VMs under ~/.tart/vms are never auto-pruned;
  # per-job clones are APFS copy-on-write.
  if [[ -n "$BASE_IMAGE" ]]; then
    if [[ "$BASE_IMAGE" == */* || "$BASE_IMAGE" == *:* ]]; then
      echo "ERROR: BASE_IMAGE must name an existing LOCAL tart VM (got: $BASE_IMAGE)" >&2
      echo "       For a remote image, pass SOURCE_IMAGE instead." >&2
      exit 1
    fi
    step "Using existing local base VM: $BASE_IMAGE"
    if ! tart list --format json | jq -e --arg n "$BASE_IMAGE" \
        '.[] | select(.Source=="local" and .Name==$n)' >/dev/null; then
      echo "ERROR: local VM '$BASE_IMAGE' not found — rsync/build it first, or unset" >&2
      echo "       BASE_IMAGE to pull SOURCE_IMAGE instead." >&2
      exit 1
    fi
    # Image arrived out of band — don't record a misleading provenance.
    SOURCE_IMAGE=""
  else
    local src_tag
    src_tag="${SOURCE_IMAGE##*:}"
    if [[ "$SOURCE_IMAGE" != *:* || "$src_tag" == "latest" || "$src_tag" == */* ]]; then
      echo "ERROR: SOURCE_IMAGE must be pinned to a version tag (got: $SOURCE_IMAGE)" >&2
      echo "       ':latest' moves under the fleet — the pinned tag is the audit trail." >&2
      exit 1
    fi
    BASE_IMAGE="base-$(basename "${SOURCE_IMAGE%:*}")-${src_tag}"
    # Record the tag verbatim. The orchestrator's fallback splits BASE_IMAGE on
    # the last `-`, which truncates a hyphenated tag (26.5-rc.1 → "rc.1") and
    # would make two builds collide under one image-* label.
    IMAGE_TAG="$src_tag"
    if tart list --format json | jq -e --arg n "$BASE_IMAGE" \
        '.[] | select(.Source=="local" and .Name==$n)' >/dev/null; then
      step "Local base VM $BASE_IMAGE already present — skipping download"
    else
      # Disk preflight: the expanded image lands on this volume, and thin
      # headroom is exactly what produced the cache-thrash death spiral this
      # script's local-image model exists to prevent. Fail on hopeless, warn
      # on tight.
      local free_gb
      free_gb="$(df -g / | awk 'NR==2 {print $4}')"
      if [[ "$free_gb" -lt 40 ]]; then
        echo "ERROR: only ${free_gb} GB free on / — not pulling a macOS image into that." >&2
        echo "       Free disk (or use a smaller SOURCE_IMAGE) and re-run." >&2
        exit 1
      elif [[ "$free_gb" -lt 120 ]]; then
        echo "WARNING: ${free_gb} GB free on / — a full Xcode image expands to ~90 GB" >&2
        echo "         and ephemeral clone write-deltas need headroom on top." >&2
      fi
      if [[ -n "$REGISTRY_USER" && -n "$REGISTRY_PAT" ]]; then
        step "tart login ${SOURCE_IMAGE%%/*}"
        printf '%s' "$REGISTRY_PAT" | tart login "${SOURCE_IMAGE%%/*}" \
          --username "$REGISTRY_USER" --password-stdin
      fi
      step "Materialising $SOURCE_IMAGE as local VM $BASE_IMAGE (one-time download)"
      tart clone "$SOURCE_IMAGE" "$BASE_IMAGE"
    fi
  fi
  # The orchestrator reaps every VM carrying VM_PREFIX; the base VM must never
  # be eligible, or the first cycle deletes the image every later cycle clones.
  if [[ "$BASE_IMAGE" == "$VM_PREFIX"* ]]; then
    echo "ERROR: base VM name must not start with VM_PREFIX '$VM_PREFIX' (the orchestrator reaps those)" >&2
    exit 1
  fi

  # -----------------------------------------------------------------------
  # Runner group + repo scoping
  # -----------------------------------------------------------------------
  step "Ensuring runner group '$RUNNER_GROUP' exists"
  local groups_json group_id
  groups_json="$(gh_api "https://api.github.com/orgs/$GH_ORG/actions/runner-groups")"
  group_id="$(echo "$groups_json" | jq -r --arg n "$RUNNER_GROUP" \
    '.runner_groups[] | select(.name==$n) | .id')"

  if [[ -z "$group_id" || "$group_id" == "null" ]]; then
    local visibility="all"
    local body
    if [[ -n "$SCOPE_REPO" ]]; then
      visibility="selected"
    fi
    body="$(jq -nc --arg name "$RUNNER_GROUP" --arg vis "$visibility" \
      '{name:$name, visibility:$vis, selected_repository_ids:[], allows_public_repositories:false}')"
    group_id="$(gh_api -X POST \
      "https://api.github.com/orgs/$GH_ORG/actions/runner-groups" \
      -d "$body" | jq -r .id)"
    echo "  created group id=$group_id (visibility=$visibility)"
  else
    echo "  found existing group id=$group_id"
  fi

  if [[ -n "$SCOPE_REPO" ]]; then
    step "Scoping group to $SCOPE_REPO"
    local repo_id
    repo_id="$(gh_api "https://api.github.com/repos/$SCOPE_REPO" | jq -r .id)"
    gh_api -X PUT \
      "https://api.github.com/orgs/$GH_ORG/actions/runner-groups/$group_id/repositories/$repo_id" \
      -o /dev/null
    echo "  repo id=$repo_id added to group"
  fi

  # -----------------------------------------------------------------------
  # Persist config (so the orchestrator + future re-runs find it)
  # -----------------------------------------------------------------------
  step "Writing config to $CONFIG_FILE"
  mkdir -p "$CONFIG_DIR"
  umask 077
  cat > "$CONFIG_FILE" <<EOF
# Auto-generated by mac-runner-setup.sh. Re-running setup overwrites this.
GH_ORG="$GH_ORG"
# GH_PAT is written ONLY in the default model. With OP_ITEM_REF set the PAT is
# never persisted — the orchestrator op-reads it per cycle (see "Credentials"
# in the setup script header).
$(if [[ -n "$OP_ITEM_REF" ]]; then
    printf 'OP_ITEM_REF="%s"\n' "$OP_ITEM_REF"
    printf 'OP_TOKEN_FILE="%s"' "$OP_TOKEN_FILE"
  else
    printf 'GH_PAT="%s"' "$GH_PAT"
  fi)
RUNNER_GROUP="$RUNNER_GROUP"
SHARED_LABEL="$SHARED_LABEL"
HOST_LABEL="$HOST_LABEL"
EXTRA_LABELS="$EXTRA_LABELS"
REQUIRE_XCODE="$REQUIRE_XCODE"
SCOPE_REPO="$SCOPE_REPO"
# BASE_IMAGE is a LOCAL tart VM name — never a remote ref (see "Base image
# model" in the setup script header). SOURCE_IMAGE records provenance only;
# it is empty when the base VM arrived out of band.
BASE_IMAGE="$BASE_IMAGE"
SOURCE_IMAGE="$SOURCE_IMAGE"
# Exact source tag when this install derived BASE_IMAGE from SOURCE_IMAGE;
# empty for an out-of-band local VM, where the orchestrator falls back to
# splitting BASE_IMAGE's name.
IMAGE_TAG="${IMAGE_TAG:-}"
VM_MEMORY_MB="$VM_MEMORY_MB"
VM_CPU_COUNT="$VM_CPU_COUNT"
VM_DISK_GB="$VM_DISK_GB"
HOST_RESERVE_MB="$HOST_RESERVE_MB"
RUNNER_VERSION="$RUNNER_VERSION"
# Namespaces this install's ephemeral VMs. Two installs on one host MUST NOT
# share a prefix — startup reaping matches on it.
VM_PREFIX="$VM_PREFIX"
EOF
  chmod 600 "$CONFIG_FILE"

  # -----------------------------------------------------------------------
  # Orchestrator
  # -----------------------------------------------------------------------
  step "Writing $ORCH_SCRIPT"
  cat > "$ORCH_SCRIPT" <<'ORCHESTRATOR_EOF'
#!/usr/bin/env bash
# Ephemeral Tart GHA runner orchestrator. Generated by mac-runner-setup.sh.
# Loops: clone base image → boot VM → wait for ssh → register JIT ephemeral
# runner → run one job → destroy VM. Registration happens only after the VM
# is reachable, so runners never sit "offline" in GitHub during boot and a
# boot failure can't strand a registration.

set -uo pipefail

# Resolve config dir from env (set by launchd) or default.
CONFIG_DIR="${CONFIG_DIR:-$HOME/.gha-runner}"
# shellcheck disable=SC1090
source "$CONFIG_DIR/config.env"
LEDGER="$CONFIG_DIR/pending-runners"
CURRENT_RUNNER_ID=""

# A cycle shorter than this that never took a job did not "finish early" — it
# was refused. Chosen above a VM's boot-to-listening time (~15-25s here) and
# below any real job, so an idle runner waiting for work never trips it: an
# idle ephemeral runner blocks in run.sh until the broker sends something,
# which is minutes at least, not seconds.
# Namespaces this install's ephemeral VMs, for both naming and reaping.
# Defaulted here as well as written by setup, so an orchestrator regenerated
# over a config.env from before VM_PREFIX existed still starts.
VM_PREFIX="${VM_PREFIX:-ephem-}"
FAST_CYCLE_SECS="${FAST_CYCLE_SECS:-60}"
# Ceiling on the progressive backoff. Long enough to stop hammering
# generate-jitconfig through an outage, short enough that the fleet recovers
# on its own within a few minutes of the cause being fixed.
FAST_CYCLE_MAX_BACKOFF="${FAST_CYCLE_MAX_BACKOFF:-300}"

log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

# --- registration credential -------------------------------------------
# Two models (chosen at install time; see the setup header's "Credentials"):
#   OP_ITEM_REF set  → fetch from 1Password at the top of EVERY cycle. The PAT
#                      is never persisted, so rotating it is a vault edit that
#                      lands on the next cycle with no host visit.
#   OP_ITEM_REF unset→ GH_PAT was sourced from config.env above.
#
# No fallback by design: with op-read on, a PAT cached on disk would defeat the
# whole point. If 1Password is unreachable the cycle backs off and retries —
# in-flight jobs are untouched because this runs BEFORE the VM is cloned.
# A GH_PAT in the environment overrides op-read for local debugging only; never
# put it in the plist.
# Sets GH_PAT_CURRENT; returns non-zero on failure. Deliberately NOT a
# stdout-returning function: log() writes to stdout, so a `$(resolve_gh_pat)`
# capture would swallow every diagnostic AND concatenate the log line onto the
# token on the override path. Setting a variable keeps diagnostics in
# orchestrator.log where triage expects them.
resolve_gh_pat() {
  GH_PAT_CURRENT=""
  if [[ -z "${OP_ITEM_REF:-}" ]]; then
    GH_PAT_CURRENT="${GH_PAT:-}"
    return 0
  fi
  if [[ -n "${GH_PAT:-}" ]]; then
    log "using GH_PAT env override (local debug only — not for plists)"
    GH_PAT_CURRENT="$GH_PAT"
    return 0
  fi
  local token_file="${OP_TOKEN_FILE:-$HOME/.config/gha-runner/op-token}"
  if [[ ! -r "$token_file" ]]; then
    log "ERROR: op token file missing/unreadable: $token_file — re-run setup"
    return 1
  fi
  local out err_file op_rc
  err_file="$(mktemp)"
  out="$(OP_SERVICE_ACCOUNT_TOKEN="$(cat "$token_file")" \
         op read "$OP_ITEM_REF" 2>"$err_file")"
  op_rc=$?
  if [[ $op_rc -eq 0 && -n "${out//[[:space:]]/}" ]]; then
    rm -f "$err_file"
    GH_PAT_CURRENT="$out"
    return 0
  fi
  local err; err="$(cat "$err_file")"; rm -f "$err_file"

  # Distinguishable classes — triage should be "which of these four", not a log
  # dive. Never echo op's raw output; it can carry vault metadata into a log
  # that outlives the incident.
  #
  # A zero exit with empty output is its OWN class: the item resolved but the
  # field is blank. Reporting that as "unreachable" would send whoever is
  # holding the pager at 3am to check 1Password's status page instead of the
  # one field that is actually wrong.
  if [[ $op_rc -eq 0 ]]; then
    log "ERROR: op read returned an EMPTY credential for $OP_ITEM_REF — the item resolved but its field is blank"
    return 1
  fi
  case "$err" in
    *401*|*Unauthorized*|*"invalid service account token"*)
      log "ERROR: op read failed — bad service-account token (rotate it, re-run setup)" ;;
    *"isn't an item"*|*"not found"*|*"no vault"*)
      log "ERROR: op read failed — missing item ($OP_ITEM_REF); check the vault" ;;
    *)
      log "ERROR: op unreachable — 1Password down or no network; retrying next cycle" ;;
  esac
  return 1
}

gh_api() {
  curl -fsS \
    -H "Authorization: Bearer $GH_PAT_CURRENT" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "$@"
}

ssh_vm() {
  # Force password auth (sshpass supplies it). Without this, ssh offers every
  # key in the host's ssh-agent first and trips the guest sshd's MaxAuthTries
  # → "Too many authentication failures" before the password is ever tried.
  sshpass -p admin ssh \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o ServerAliveInterval=30 \
    -o LogLevel=ERROR \
    -o PreferredAuthentications=password \
    -o PubkeyAuthentication=no \
    -o IdentitiesOnly=yes \
    -o NumberOfPasswordPrompts=1 \
    "admin@$1" "${@:2}"
}

fetch_group_id() {
  gh_api "https://api.github.com/orgs/$GH_ORG/actions/runner-groups" \
    | jq -r --arg n "$RUNNER_GROUP" '.runner_groups[] | select(.name==$n) | .id'
}

cleanup_vm() {
  local name="$1"
  tart stop "$name" >/dev/null 2>&1 || true
  tart delete "$name" >/dev/null 2>&1 || true
}

# --- GitHub-side runner cleanup ------------------------------------------
# Ephemeral runners only self-deregister after finishing a job. One killed
# while idle-waiting (reboot / launchctl unload / crash) lingers in GitHub as
# an "offline" runner forever. Track every id we register in a ledger; delete
# leftovers at startup and as each runner is released.
deregister_runner() {
  [[ -n "${1:-}" ]] || return 0
  gh_api -X DELETE \
    "https://api.github.com/orgs/$GH_ORG/actions/runners/$1" -o /dev/null 2>/dev/null || true
}
ledger_add() { [[ -n "${1:-}" ]] && printf '%s\n' "$1" >> "$LEDGER"; return 0; }
ledger_remove() {
  [[ -f "$LEDGER" && -n "${1:-}" ]] || return 0
  grep -vxF "$1" "$LEDGER" > "$LEDGER.tmp" 2>/dev/null || :
  mv "$LEDGER.tmp" "$LEDGER" 2>/dev/null || :
}
# Release the in-flight runner: drop it from the ledger and deregister it
# (idempotent — a 404 just means the ephemeral runner already self-removed).
release_current_runner() {
  [[ -n "$CURRENT_RUNNER_ID" ]] || return 0
  ledger_remove "$CURRENT_RUNNER_ID"
  deregister_runner "$CURRENT_RUNNER_ID"
  CURRENT_RUNNER_ID=""
}
# Anything still in the ledger at startup was registered but never finished
# (reboot/crash) — reap it. Runs before the loop, so it can't touch a runner
# this process is about to create.
reap_pending_runners() {
  [[ -f "$LEDGER" ]] || return 0
  while read -r rid; do
    [[ -n "$rid" ]] && { log "reaping leftover runner id=$rid"; deregister_runner "$rid"; }
  done < "$LEDGER"
  : > "$LEDGER"
}

# Capacity-based scheduling: wait until host has enough free RAM for
# (this VM + HOST_RESERVE_MB). With multiple orchestrators on one
# machine, each waits independently — on a 16 GB host with two
# orchestrators wanting 10 GB VMs, they serialise naturally; on a
# 64 GB host they run concurrently.
host_total_mb() {
  echo "$(( $(sysctl -n hw.memsize) / 1024 / 1024 ))"
}
running_vm_mem_mb() {
  # `tart list --format json` no longer reports Memory (tart 2.x emits only
  # Accessed/Disk/Name/Running/Size/Source/State), which silently zeroed this
  # sum and let every orchestrator boot at once. `tart get <vm>` still
  # reports the configured Memory (MB) — ask it per running VM.
  local total=0 m vm
  while read -r vm; do
    [[ -n "$vm" ]] || continue
    m="$(tart get "$vm" --format json 2>/dev/null | jq -r '.Memory // 0')"
    total=$(( total + ${m:-0} ))
  done < <(tart list --format json 2>/dev/null \
             | jq -r '.[]? | select(.State=="running") | .Name')
  echo "$total"
}
wait_for_ram_capacity() {
  local total free needed
  total="$(host_total_mb)"
  needed=$(( VM_MEMORY_MB + HOST_RESERVE_MB ))
  while true; do
    free=$(( total - $(running_vm_mem_mb) ))
    if [[ "$free" -ge "$needed" ]]; then
      return 0
    fi
    log "waiting for RAM (need $needed MB, $free MB free, total $total MB)"
    sleep 15
  done
}

# Reap any orphans left from a setup re-run that killed us mid-job.
#
# Scoped to VM_PREFIX, which is what makes two installs able to share a host.
# This runs at every orchestrator start — including a KeepAlive restart after a
# crash and every login — so an unscoped sweep would delete the OTHER install's
# running VM and kill the CI job on it. Each install therefore reaps only what
# it could have created.
reap_orphans() {
  tart list --format json 2>/dev/null \
    | jq -r --arg p "$VM_PREFIX" '.[]? | select(.Name | startswith($p)) | .Name' \
    | while read -r orphan; do
        [ -n "$orphan" ] && cleanup_vm "$orphan"
      done
}
reap_orphans
# Startup reaping calls the GitHub API, so it needs a credential too. Best
# effort: if it can't be resolved (1Password down at boot), skip the reap
# rather than refuse to start — the ledger persists and the next successful
# startup clears it.
startup_reap_pending=1
if resolve_gh_pat; then
  reap_pending_runners
  startup_reap_pending=0
else
  log "deferring startup reap — no credential yet; will run on first good cycle"
fi
# Per-VM console logs: the happy path deletes its own; failures keep theirs
# for post-mortems. Don't let those accumulate forever.
find "$CONFIG_DIR" -name "vm-${VM_PREFIX}*.log" -mtime +7 -delete 2>/dev/null || true
# Per-cycle run captures are deleted at the end of their own cycle; any left
# behind belong to a cycle killed mid-flight, so they are pure residue.
find "$CONFIG_DIR" -name "run-${VM_PREFIX}*.log" -delete 2>/dev/null || true

# Consecutive cycles that ended 0 without taking a job. A rejected runner
# looks exactly like a healthy one that finished instantly, so this counter is
# the only thing separating "idle fleet" from "every runner is being refused".
no_job_streak=0

while true; do
  # Fetch the credential FIRST, before any VM exists, so a credential failure
  # can never orphan or kill a VM. With op-read this is the per-cycle fetch
  # that makes vault-edit rotation land without touching the host.
  if ! resolve_gh_pat; then
    sleep 60
    continue
  fi
  # If the startup reap was skipped (1Password down at boot), do it on the
  # first cycle that has a credential — otherwise runners stranded by the
  # previous crash linger in GitHub until someone restarts the agent.
  if [[ "$startup_reap_pending" == "1" ]]; then
    log "running deferred startup reap"
    reap_pending_runners
    startup_reap_pending=0
  fi
  release_current_runner
  vm_name="${VM_PREFIX}$(uuidgen | tr 'A-Z' 'a-z' | cut -c1-8)"
  runner_name="$HOST_LABEL-$(date +%s)"
  log "spawning vm=$vm_name runner=$runner_name"

  if ! tart clone "$BASE_IMAGE" "$vm_name"; then
    log "ERROR: tart clone failed"; sleep 30; continue
  fi
  tart set "$vm_name" \
    --memory "$VM_MEMORY_MB" \
    --cpu "$VM_CPU_COUNT" >/dev/null
  # Tart can only GROW a disk — the cirruslabs xcode images already ship a
  # 140 GB disk, and asking for less errors ("new disk size should be larger
  # than the current disk size") on every single cycle. Apply VM_DISK_GB only
  # when set and strictly larger than what the clone already has; clones are
  # APFS copy-on-write, so a bigger number costs nothing until written to.
  if [[ -n "${VM_DISK_GB:-}" ]]; then
    current_disk="$(tart list --format json \
      | jq -r --arg n "$vm_name" '.[] | select(.Name==$n) | .Disk // 0')"
    if [[ "$VM_DISK_GB" -gt "${current_disk:-0}" ]]; then
      tart set "$vm_name" --disk-size "$VM_DISK_GB" >/dev/null
    fi
  fi

  # Block until the host has RAM for this VM (auto-scales
  # concurrency across orchestrators based on host capacity).
  wait_for_ram_capacity

  tart run "$vm_name" --no-graphics >>"$CONFIG_DIR/vm-$vm_name.log" 2>&1 &
  vm_pid=$!
  trap 'cleanup_vm "$vm_name"; release_current_runner; exit' INT TERM

  vm_ip=""
  for _ in $(seq 1 90); do
    vm_ip="$(tart ip "$vm_name" 2>/dev/null || true)"
    [[ -n "$vm_ip" ]] && break
    sleep 2
  done
  if [[ -z "$vm_ip" ]]; then
    log "ERROR: vm never got an IP"; cleanup_vm "$vm_name"; sleep 30; continue
  fi
  log "vm $vm_name @ $vm_ip — waiting for sshd"
  ssh_ok=""
  for _ in $(seq 1 60); do
    ssh_vm "$vm_ip" "true" >/dev/null 2>&1 && { ssh_ok=1; break; }
    sleep 2
  done
  if [[ -z "$ssh_ok" ]]; then
    log "ERROR: sshd never came up"; cleanup_vm "$vm_name"; sleep 30; continue
  fi

  # ── Capability labels, READ OUT OF THE BOOTED VM ─────────────────────
  # Workflows gate on these (`runs-on: [macos-major-26, xcode-26.6]`) so a job
  # with a toolchain floor cannot land on an image that lacks it.
  #
  # DERIVED, never hand-maintained. A label taken from config.env or inferred
  # from BASE_IMAGE's name asserts what SHOULD be in the image; only the VM
  # knows what IS. An asserted label that has drifted is worse than no gate at
  # all — it routes the job confidently to the wrong toolchain. So the probe
  # OWNS the `macos-major-*`, `xcode-*` and `image-*` namespaces, and a static
  # label in one of them is discarded below.
  #
  # ONE ssh round-trip for all probes, retried. Two back-to-back connections
  # proved flaky in practice (the second returned empty), which silently
  # dropped a label and left gated jobs queued until GitHub's 24h auto-cancel —
  # a stall that reads as "no capacity" rather than "probe failed".
  #
  # The remote side assembles the values and prints EXACTLY two lines. Letting
  # each probe write its own line is a trap: a command that produces no stdout
  # (`xcodebuild` on an Xcode-less image) emits no line at all rather than an
  # empty one, so every later value shifts up — the macOS version would be read
  # as the Xcode version, advertising a fabricated `xcode-26`. Assembling first
  # and printing once keeps line N meaning field N. Redirecting ~/.zprofile's
  # stdout matters for the same reason: a profile that echoes anything would
  # otherwise land in the parsed output.
  vm_xcode=""; vm_macos_major=""; probe_ok=0
  for probe_attempt in 1 2 3; do
    probe="$(ssh_vm "$vm_ip" 'source ~/.zprofile >/dev/null 2>&1 || true; x="$(xcodebuild -version 2>/dev/null | sed -n "1s/^Xcode //p")"; m="$(sw_vers -productVersion 2>/dev/null | cut -d. -f1)"; printf "%s\n%s\n" "$x" "$m"' 2>/dev/null || true)"
    vm_xcode="$(printf '%s\n' "$probe" | sed -n 1p | tr -d '[:space:]')"
    vm_macos_major="$(printf '%s\n' "$probe" | sed -n 2p | tr -d '[:space:]')"
    probe_ok=1
    # sw_vers exists on every macOS, so a missing major version means the probe
    # itself failed, not that the image lacks something.
    [[ -z "$vm_macos_major" ]] && probe_ok=0
    [[ "${REQUIRE_XCODE:-0}" == "1" && -z "$vm_xcode" ]] && probe_ok=0
    [[ "$probe_ok" == "1" ]] && break
    log "capability probe attempt $probe_attempt incomplete (xcode='${vm_xcode:-none}' macos='${vm_macos_major:-none}'); retrying"
    sleep 5
  done

  # Recycle rather than register a half-labelled runner: one that is missing a
  # capability label cannot serve gated jobs, so registering it produces a
  # silent queue-until-cancel. A fresh VM self-heals from a transient flake.
  if [[ "$probe_ok" != "1" ]]; then
    log "ERROR: capability probe failed after 3 attempts in $vm_name; recycling VM"
    cleanup_vm "$vm_name"; sleep 30; continue
  fi

  # No Xcode is a legitimate image for a non-Apple-toolchain fleet, so it is a
  # note rather than an error — the xcode-* label is simply absent and gated
  # jobs pass this runner by. Set REQUIRE_XCODE=1 on a fleet where a missing
  # Xcode means a broken image and you want it to fail loudly instead.
  if [[ -z "$vm_xcode" ]]; then
    log "note: no Xcode found in $vm_name — registering without an xcode-* label"
  fi

  # Which image this VM was cloned from, recorded as a label so a bad build is
  # traceable from the job page without shelling into the host. IMAGE_TAG is
  # the exact tag captured at install time; the fallback splits BASE_IMAGE's
  # name (e.g. `zukan-mobile-runner-2026.07.4` → `2026.07.4`) for a VM that
  # arrived out of band, and is lossy for a hyphenated tag.
  image_tag="${IMAGE_TAG:-${BASE_IMAGE##*[:-]}}"
  derived_labels="macos-major-${vm_macos_major},image-${image_tag}"
  [[ -n "$vm_xcode" ]] && derived_labels="${derived_labels},xcode-${vm_xcode}"
  log "probed capabilities: $derived_labels"

  # Register the runner only now that the VM can actually take a job.
  # Minting the JIT config before boot left a runner visible-but-offline in
  # GitHub for the whole boot window (a slow cycle reads as a dead host in
  # the runners UI), and a boot failure stranded a registration that had to
  # be reaped later. Registered here, the offline window is the seconds
  # between this call and run.sh connecting.
  GROUP_ID="$(fetch_group_id)"
  if [[ -z "$GROUP_ID" || "$GROUP_ID" == "null" ]]; then
    log "ERROR: runner group '$RUNNER_GROUP' not found"
    cleanup_vm "$vm_name"; sleep 60; continue
  fi

  # JIT-registered runners don't auto-apply the platform labels that
  # ./config.sh normally would (self-hosted / macOS / arm64). The
  # `labels` field passed to generate-jitconfig is the COMPLETE set,
  # so include them explicitly — otherwise workflows that ask for
  # `[self-hosted, macos-26]` won't match this runner. EXTRA_LABELS
  # (comma-separated) advertises image capabilities (e.g. mobile-runner)
  # so capability-gated workflows can route here.
  #
  # The probe above owns `macos-major-*`, `xcode-*` and `image-*`: a static
  # SHARED_LABEL/EXTRA_LABELS entry in one of those namespaces is an assertion
  # about the image that may have drifted, so it is dropped and the probed
  # value used instead. Put capabilities the VM cannot report (e.g.
  # `mobile-runner`) in EXTRA_LABELS; anything it CAN report comes from the
  # probe, not config.env.
  #
  # HOST_LABEL is exempt: it is the host's IDENTITY, not a capability claim, so
  # a mini literally named `xcode-mini` keeps its label and
  # `runs-on: [self-hosted, xcode-mini]` still works. Label matching is exact
  # string equality, so an identity label can never satisfy a job gated on
  # `xcode-26.6`.
  #
  # A static label that AGREES with the probe is a silent no-op; one that
  # contradicts it means config.env has drifted from the image, which is worth
  # saying out loud once per cycle rather than discovering via a job that never
  # gets scheduled.
  # Matched case-INSENSITIVELY: GitHub treats runner labels that way, so a
  # config entry of `Xcode-26.5` would otherwise slip past this filter and go
  # on satisfying `runs-on: [xcode-26.5]` next to the probed `xcode-26.6`.
  # `clean` trims each entry: `EXTRA_LABELS="mobile-runner, xcode-26.5"` is a
  # natural way to write the list, and the resulting " xcode-26.5" would slip
  # past the ^-anchored namespace regex and get registered as-is.
  stale_labels="$(jq -nr --arg s "$SHARED_LABEL" --arg x "${EXTRA_LABELS:-}" \
    --arg d "$derived_labels" \
    'def clean: map(gsub("^[[:space:]]+|[[:space:]]+$"; "")) | map(select(length > 0));
     ($d | split(",") | clean | map(ascii_downcase)) as $probed
     | (([$s] + ($x | split(","))) | clean)
     | map(select(test("^(macos-major|xcode|image)-"; "i")))
     | map(select(. as $l | ($probed | index($l | ascii_downcase)) == null))
     | join(", ")')"
  if [[ -n "$stale_labels" ]]; then
    log "WARNING: config label(s) contradict the image, using probed values: $stale_labels"
  fi

  labels_json="$(jq -nc --arg s "$SHARED_LABEL" --arg h "$HOST_LABEL" \
    --arg x "${EXTRA_LABELS:-}" --arg d "$derived_labels" \
    'def clean: map(gsub("^[[:space:]]+|[[:space:]]+$"; "")) | map(select(length > 0));
     ((([$s] + ($x | split(","))) | clean)
      | map(select(test("^(macos-major|xcode|image)-"; "i") | not)))
     + ["self-hosted", "macOS", "arm64", $h]
     + ($d | split(",") | clean)
     | clean
     | unique')"
  jit_body="$(jq -nc \
    --arg name "$runner_name" \
    --argjson group_id "$GROUP_ID" \
    --argjson labels "$labels_json" \
    '{name:$name, runner_group_id:$group_id, labels:$labels, work_folder:"_work"}')"
  jit_response="$(gh_api -X POST \
    "https://api.github.com/orgs/$GH_ORG/actions/runners/generate-jitconfig" \
    -d "$jit_body")" || {
    log "ERROR: generate-jitconfig failed"
    cleanup_vm "$vm_name"; sleep 30; continue
  }
  jitconfig="$(echo "$jit_response" | jq -r .encoded_jit_config)"
  if [[ -z "$jitconfig" || "$jitconfig" == "null" ]]; then
    log "ERROR: empty JIT config from API"
    cleanup_vm "$vm_name"; sleep 30; continue
  fi

  # generate-jitconfig returns the runner's id; record it so a reboot mid-job
  # doesn't strand the registration (reaped by reap_pending_runners at boot).
  runner_id="$(echo "$jit_response" | jq -r '.runner.id')"
  [[ "$runner_id" == "null" ]] && runner_id=""
  CURRENT_RUNNER_ID="$runner_id"
  ledger_add "$runner_id"

  # 2>&1 is load-bearing. run.sh reports a REJECTED runner on stderr, and
  # launchd sends orchestrator stderr to orchestrator.err — a file nobody
  # tails, while orchestrator.log (stdout) shows a cycle that looks fine. The
  # line that named a real outage ("Runner version v2.335.1 is deprecated and
  # cannot receive messages") sat there unread through 8,245 cycles. Put the
  # runner's own diagnosis in the log the operator actually reads.
  #
  # tee'd to a per-cycle file so the loop can ask the one question the exit
  # code cannot answer: did this runner ever get a job? PIPESTATUS[0] keeps
  # run.sh's status rather than tee's.
  cycle_started="$(date +%s)"
  cycle_out="$CONFIG_DIR/run-$vm_name.log"
  ssh_vm "$vm_ip" "bash -s -- '$jitconfig' '${RUNNER_VERSION:-}'" 2>&1 <<'INVMEOF' | tee "$cycle_out"
set -euo pipefail
JITCONFIG="$1"
RUNNER_VERSION="${2:-}"
cd "$HOME"

# Toolchain-baked images export their PATH in ~/.zprofile (node, JDK,
# Android SDK, Maestro, …). Source it so the runner — and every job step it
# spawns — inherits the image's toolchain the way a login shell would.
# shellcheck disable=SC1090
source ~/.zprofile 2>/dev/null || true

# Images that bake ~/actions-runner (e.g. Packer-built CI images) ship a
# runner that AGES. GitHub retires old runner versions and refuses them at
# the broker — "Runner version vX.Y.Z is deprecated and cannot receive
# messages" — AFTER the JIT registration has already succeeded. The failure
# therefore presents as a runner that appears in GitHub and goes offline a
# few seconds later, which reads as a boot/network problem rather than a
# version one, and it hot-loops: the runner exits 0, so the orchestrator's
# non-zero backoff never fires.
#
# So RUNNER_VERSION is the AUTHORITY, not just a fallback for images with no
# runner. A baked runner that disagrees with it is replaced. Before this,
# RUNNER_VERSION was silently inert on any image that baked a runner — a knob
# that looked like the fix for exactly this failure and did nothing, which
# cost a real diagnosis twice (v2.334.0, then v2.335.1).
#
# The pin stays a pin: the version is never resolved as "latest" from the
# API, which is rate-limitable and would let the fleet drift mid-flight.
runner_installed_version() {
  [[ -x ~/actions-runner/config.sh ]] || return 1
  (cd ~/actions-runner && ./config.sh --version 2>/dev/null | tr -d '[:space:]')
}

install_runner() {
  local want="$1" tmp
  tmp="$(mktemp -d)"
  local url="https://github.com/actions/runner/releases/download/v$want/actions-runner-osx-arm64-$want.tar.gz"
  if ! curl -fsSL -o "$tmp/runner.tar.gz" "$url"; then
    echo "ERROR: could not download actions/runner v$want from $url" >&2
    rm -rf "$tmp"; return 1
  fi
  # Replace wholesale rather than untar over the top: a partial overlay of a
  # different version leaves mismatched assemblies in bin/ and fails at run
  # time with an error that points nowhere near the cause. The VM is
  # ephemeral, so discarding the baked directory costs nothing.
  rm -rf ~/actions-runner
  mkdir -p ~/actions-runner
  tar xzf "$tmp/runner.tar.gz" -C ~/actions-runner
  rm -rf "$tmp"
}

have_version="$(runner_installed_version || true)"
if [[ -z "$have_version" ]]; then
  if [[ -z "$RUNNER_VERSION" ]]; then
    echo "ERROR: image bakes no runner and RUNNER_VERSION is unset" >&2
    exit 1
  fi
  echo "no runner in image — installing pinned v$RUNNER_VERSION"
  install_runner "$RUNNER_VERSION"
elif [[ -n "$RUNNER_VERSION" && "$have_version" != "$RUNNER_VERSION" ]]; then
  echo "baked runner v$have_version != pinned v$RUNNER_VERSION — replacing"
  install_runner "$RUNNER_VERSION"
else
  echo "using baked runner v$have_version"
fi

cd ~/actions-runner
exec ./run.sh --jitconfig "$JITCONFIG"
INVMEOF
  exit_code="${PIPESTATUS[0]}"
  cycle_secs=$(( $(date +%s) - cycle_started ))
  # "Running job:" is run.sh's own line when the broker hands it work. Its
  # absence is what distinguishes a runner that waited and was told to stop
  # from one that was never allowed to participate.
  took_job=0
  grep -q "Running job:" "$cycle_out" 2>/dev/null && took_job=1
  rm -f "$cycle_out"
  log "vm $vm_name runner exited (code=$exit_code, ${cycle_secs}s, took_job=$took_job)"

  cleanup_vm "$vm_name"
  wait "$vm_pid" 2>/dev/null || true
  if [[ "$exit_code" -ne 0 ]]; then
    no_job_streak=0
    log "backoff 30s on non-zero exit"
    sleep 30
  elif [[ "$took_job" == "0" && "$cycle_secs" -lt "$FAST_CYCLE_SECS" ]]; then
    # Exit 0, no job, and far too quick to have waited for one. A runner the
    # broker refuses lands here; so does a group or permission change that
    # makes this runner ineligible. Both previously span at ~25s/cycle
    # forever, because exit 0 means "clean" to the check above.
    #
    # Back off progressively rather than fixed: the first few may genuinely be
    # trivial jobs, but a sustained streak is an outage, and hammering
    # generate-jitconfig through it just buries the evidence.
    no_job_streak=$(( no_job_streak + 1 ))
    backoff=$(( 30 * no_job_streak ))
    [[ "$backoff" -gt "$FAST_CYCLE_MAX_BACKOFF" ]] && backoff="$FAST_CYCLE_MAX_BACKOFF"
    log "WARNING: runner exited 0 after ${cycle_secs}s without taking a job (${no_job_streak}x consecutively)."
    log "         That is what a REFUSED runner looks like — not an idle one."
    log "         Most likely a deprecated actions/runner version (bump RUNNER_VERSION"
    log "         in $CONFIG_DIR/config.env, then reload the agent), or a runner-group"
    log "         or permission change. The runner's own words are just above."
    log "         backoff ${backoff}s"
    sleep "$backoff"
  else
    no_job_streak=0
    # Clean cycle → its console log holds nothing worth keeping. Failed
    # cycles keep theirs; the startup sweep ages those out after 7 days.
    rm -f "$CONFIG_DIR/vm-$vm_name.log"
  fi
done
ORCHESTRATOR_EOF
  chmod +x "$ORCH_SCRIPT"

  # -----------------------------------------------------------------------
  # launchd
  # -----------------------------------------------------------------------
  step "Installing launchd service ($LAUNCHD_LABEL)"
  mkdir -p "$(dirname "$PLIST_PATH")"
  cat > "$PLIST_PATH" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LAUNCHD_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$ORCH_SCRIPT</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$CONFIG_DIR/orchestrator.log</string>
  <key>StandardErrorPath</key>
  <string>$CONFIG_DIR/orchestrator.err</string>
  <key>WorkingDirectory</key>
  <string>$CONFIG_DIR</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CONFIG_DIR</key>
    <string>$CONFIG_DIR</string>
  </dict>
</dict>
</plist>
PLIST_EOF

  launchctl unload "$PLIST_PATH" 2>/dev/null || true
  launchctl load "$PLIST_PATH"

  # -----------------------------------------------------------------------
  # Done
  # -----------------------------------------------------------------------
  local other_bases
  other_bases="$(tart list --format json | jq -r --arg n "$BASE_IMAGE" \
    '.[] | select(.Source=="local") | .Name | select(startswith("base-") and . != $n)' \
    | tr '\n' ' ')"

  step "Setup complete"
  cat <<NEXT

Base image:
  • Runner clones from local VM: $BASE_IMAGE
  • To roll a new image: re-run this script with a new pinned SOURCE_IMAGE
    (or stage a local VM out of band and pass BASE_IMAGE=<name>). The old
    base VM is left in place — delete it after the first green cycle on the
    new image:  tart delete <old-base>

Service:
  • Label:      $LAUNCHD_LABEL
  • Logs:       tail -F $CONFIG_DIR/orchestrator.log
  • Stop:       launchctl unload $PLIST_PATH
  • Restart:    launchctl unload $PLIST_PATH && launchctl load $PLIST_PATH

Surviving reboots:
  This is a LaunchAgent — it starts on GUI login, not at the login window
  (Tart needs a GUI session, so a LaunchDaemon won't work). For an
  unattended host, enable auto-login so it starts itself after a reboot:
    • System Settings ▸ Users & Groups ▸ Automatically log in as ▸ <user>
      (requires FileVault OFF)
    • sudo pmset -a sleep 0 displaysleep 0 autorestart 1
  Without auto-login, log in once after each reboot to start the runner.

GitHub:
  • Each job spawns a fresh runner with labels:
      self-hosted, macOS, arm64 (auto) + $SHARED_LABEL + $HOST_LABEL${EXTRA_LABELS:+ + $EXTRA_LABELS}
      + PROBED from the booted VM: macos-major-<N>, image-<tag>, xcode-<ver>
        (xcode-* only when the image has Xcode$([[ "$REQUIRE_XCODE" == "1" ]] && printf '%s' "; REQUIRE_XCODE=1, so a VM without it is recycled"))

Workflow usage:
  runs-on: [self-hosted, $SHARED_LABEL]    # any host in the fleet
  runs-on: [self-hosted, $HOST_LABEL]      # this specific host
  runs-on: [macos-major-26, xcode-26.6]    # capability-gated, host-agnostic

  Prefer the capability form for jobs with a toolchain floor: it cannot land
  on an image that lacks what it needs, and it does not pin work to one host.

Adding another host:
  Run this script on the new machine with HOST_LABEL=<name>. Same
  GH_ORG + RUNNER_GROUP + SHARED_LABEL → joins the same fleet.
NEXT

  if [[ -n "${other_bases// /}" ]]; then
    cat <<OLDBASES
Old base VMs still on disk (delete after the first green cycle on the
current image — each holds tens of GB):
  ${other_bases}
  tart delete <name>
OLDBASES
  fi
}

__main__ "$@"
